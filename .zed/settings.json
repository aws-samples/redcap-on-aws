{
  "languages": {
    "TypeScript": {
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!prettier", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
